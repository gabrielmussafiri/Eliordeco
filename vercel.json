{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "apps/web",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "API_URL" }
      ]
    },
    "backend": {
      "root": "apps/api",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/media/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
